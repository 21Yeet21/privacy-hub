# Privacy Hub Configuration
# Copy this file to .env and fill in your specific network values.

# --- Network Interfaces ---
# The physical interface of your server that connects to your home router (e.g., eth0, ens3, wlan0)
LOCAL_IFACE=enp7s0

# The WireGuard interface created by wg-easy
WG_IFACE=wg0

# The WireGuard subnet assigned to your devices
WG_SUBNET=10.8.0.0/24

# The IP address of the Privacy Hub server on the WireGuard network
HUB_IP=10.8.0.1

# --- Cloudflare WARP ---
# The interface name created by wg-quick when WARP starts
WARP_IFACE=warp0

# --- Pi-hole DNS ---
# The IP address where Pi-hole is accessible (usually the local IP of this server)
PIHOLE_IP=192.168.1.13

# --- Tor Configuration ---
# The hashed password for Tor's Control Port (generated via: docker exec tor tor --hash-password "your_password")
TOR_CONTROL_HASH=16:YOUR_60_CHARACTER_HASH_HERE

# --- Remote Access (DuckDNS) ---
# Your DuckDNS subdomain
DUCKDNS_DOMAIN=myprivhub.duckdns.org

# Your DuckDNS authentication token
DUCKDNS_TOKEN=YOUR_DUCKDNS_TOKEN_HERE